{
  "name": "pare-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4000",
    "dev:clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true}); require('fs').rmSync('.turbo', {recursive:true, force:true}); require('fs').rmSync('node_modules/.cache', {recursive:true, force:true});\" && npm run dev",
    "clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true}); require('fs').rmSync('.turbo', {recursive:true, force:true}); require('fs').rmSync('node_modules/.cache', {recursive:true, force:true});\"",
    "build": "next build --turbopack",
    "start": "next start -p 4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-select": "^2.2.6",
    "@react-spring/web": "^10.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^12.23.21",
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.15",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.3",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
