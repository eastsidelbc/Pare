{
  "name": "pare-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4000",
    "dev:clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true}); require('fs').rmSync('.turbo', {recursive:true, force:true}); require('fs').rmSync('node_modules/.cache', {recursive:true, force:true});\" && npm run dev",
    "clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true}); require('fs').rmSync('.turbo', {recursive:true, force:true}); require('fs').rmSync('node_modules/.cache', {recursive:true, force:true});\"",
    "build": "next build --turbopack",
    "start": "next start -p 4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.21",
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.4.24",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
